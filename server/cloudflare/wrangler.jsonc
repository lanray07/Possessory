{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "possessory-receipts",
  "main": "src/index.mjs",
  "account_id": "97dc8a0148e05bf06f5a68b99618001a",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "logpush": false,
  "observability": { "enabled": false },
  "env": {
    "production": {
      "name": "possessory-receipts-production",
      "vars": { "AMAZON_PREMIUM_SKU": "possessory.premium.lifetime", "DEPLOYMENT_ENV": "production" },
      "ratelimits": [
        { "name": "IP_LIMITER", "namespace_id": "73509101", "simple": { "limit": 120, "period": 60 } },
        { "name": "RECEIPT_LIMITER", "namespace_id": "73509102", "simple": { "limit": 10, "period": 60 } }
      ]
    },
    "sandbox": {
      "name": "possessory-receipts-sandbox",
      "vars": { "AMAZON_PREMIUM_SKU": "possessory.premium.lifetime", "DEPLOYMENT_ENV": "sandbox" },
      "ratelimits": [
        { "name": "IP_LIMITER", "namespace_id": "73509201", "simple": { "limit": 120, "period": 60 } },
        { "name": "RECEIPT_LIMITER", "namespace_id": "73509202", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}
